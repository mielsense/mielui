    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:registry": "tsx scripts/build-registry.ts",
        "build": "svelte-package --input src --output dist/svelte --tsconfig tsconfig.package.json && pnpm run build:registry && node scripts/build-cli.mjs",
        "verify:artifact": "tsx scripts/verify-packed-consumer.ts",
        "verify:cli-artifact": "tsx scripts/verify-cli-artifact.ts",
        "prepublishOnly": "pnpm run build",
        "check": "pnpm run check:cli && pnpm run check:components",
        "check:cli": "tsc --noEmit -p tsconfig.cli.json",
        "check:components": "svelte-check --tsconfig ./tsconfig.components.json",
        "test": "pnpm run build:registry && vitest run",
        "sandbox": "tsx scripts/sandbox.ts",
        "lint": "biome lint ."
    },
    "dependencies": {
        "@floating-ui/dom": "1.7.6",
