{
    "name": "mielui",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.18.0",
        "pnpm": ">=10.34.5 <11"
    },
    "scripts": {
        "audit": "pnpm audit",
        "dev": "turbo run dev",
        "devnet": "turbo run devnet --filter=docs --filter=installer-lab",
        "build": "turbo run build",
        "generate": "turbo run generate",
        "check": "turbo run check",
        "lint": "biome lint .",
        "test": "turbo run test",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "release-gate": "bash scripts/release-gate.sh",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "lefthook": "1.13.6",
        "turbo": "2.10.8",
        "@types/node": "22.19.19",
        "tsx": "^4.23.13"
    },
    "dependencies": {
        "opencode-goal-plugin": "0.7.0"
    }
}
