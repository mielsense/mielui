{
    "name": "registry",
    "version": "1.0.50",
    "scripts": {
        "test": "vitest run",
        "dev": "tsx watch src/server.ts",
        "migrate:deploy": "pnpm exec prisma migrate deploy",
        "generate": "DATABASE_URL=postgresql://placeholder DIRECT_URL=postgresql://placeholder prisma generate",
        "build": "DATABASE_URL=postgresql://placeholder DIRECT_URL=postgresql://placeholder prisma generate",
        "check": "DATABASE_URL=postgresql://placeholder DIRECT_URL=postgresql://placeholder prisma generate && tsc --noEmit",
        "lint": "biome lint .",
        "start": "tsx src/server.ts"
    },
    "dependencies": {
        "@mielui/svelte": "workspace:*",
        "@elysiajs/openapi": "1.4.15",
        "@prisma/adapter-pg": "7.9.1",
        "@prisma/client": "7.9.1",
        "dotenv": "17.4.2",
        "elysia": "1.4.29",
        "pg": "8.21.0",
        "prisma": "7.9.1",
        "@elysia/node": "^1.4.6",
        "tsx": "^4.23.13"
    },
    "devDependencies": {
        "@types/pg": "8.20.0",
        "typescript": "5.9.3",
        "@types/node": "22.19.19",
        "vitest": "4.1.11"
    },
    "type": "module",
    "private": true
