{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@lib/*": ["./src/lib/*"],
            "@root/*": ["./*"],
            "@src/*": ["./src/*"]
        },
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": false,
        "emitDeclarationOnly": false
    }
}
