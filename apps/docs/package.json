{
    "name": "docs",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "node scripts/generate-api-reference.mjs && node --max-old-space-size=4096 node_modules/vite/bin/vite.js dev",
        "devnet": "node scripts/generate-api-reference.mjs && node --max-old-space-size=4096 node_modules/vite/bin/vite.js dev --host 0.0.0.0",
        "build": "node scripts/generate-api-reference.mjs && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "test": "pnpm run test:ci",
        "test:all": "vitest run",
        "test:ci": "vitest run --project unit --project ssr",
        "test:browser": "vitest run --project browser --project browser-reduced",
        "test:watch": "vitest",
        "generate:api": "node scripts/generate-api-reference.mjs"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "5.5.7",
        "@sveltejs/adapter-vercel": "6.3.4",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.1.2",
        "@tailwindcss/vite": "4.3.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/svelte": "5.3.1",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "22.19.19",
        "@vitest/browser": "4.1.11",
        "@vitest/browser-playwright": "4.1.11",
        "axe-core": "4.11.4",
        "jsdom": "29.1.1",
        "motion": "12.40.0",
        "playwright": "1.60.0",
        "svelte": "5.57.1",
        "svelte-check": "4.7.6",
        "tailwindcss": "4.3.0",
        "typescript": "5.9.3",
        "vite": "8.1.4",
        "vitest": "4.1.11",
        "vitest-browser-svelte": "2.1.1"
    },
    "dependencies": {
        "@floating-ui/dom": "1.7.6",
        "@hugeicons/core-free-icons": "^4.3.3",
        "@internationalized/date": "3.12.0",
        "@mielui/svelte": "workspace:*",
        "@scritto/core": "0.1.0",
        "@scritto/svelte": "0.1.0",
        "@tanstack/svelte-table": "9.2.4",
        "@vercel/analytics": "2.0.1",
        "clsx": "2.1.1",
        "mode-watcher": "1.1.0",
        "ogl": "1.0.11",
        "svelte-persisted-state": "1.4.1",
        "tailwind-variants": "3.2.2",
        "valibot": "^1.5.0"
    }
}
